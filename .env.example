# ==============================================================================
# Mascen Environment Configuration Template
# All keys below are optional. If omitted, Mascen automatically runs in
# lightweight local mode using zero-disk in-memory data URIs.
# ==============================================================================

# Database Connection (Neon Postgres / Drizzle ORM)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# Cloudflare R2 Storage (Optional: for persisting generated mascot atlases & logo sheets)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="mascen"
R2_PUBLIC_URL="https://pub-your-id.r2.dev"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
